{
  "name": "biasguard-cursor",
  "displayName": "BiasGuard - AI Bias Detection for Cursor",
  "description": "Real-time AI bias detection and intervention system for Cursor IDE",
  "version": "1.0.0",
  "publisher": "transformation-mvp",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Machine Learning",
    "Other",
    "Education"
  ],
  "keywords": [
    "ai",
    "bias",
    "detection",
    "cursor",
    "productivity",
    "collaboration",
    "machine learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "biasguard.toggleOverlay",
        "title": "Toggle BiasGuard Overlay",
        "category": "BiasGuard"
      },
      {
        "command": "biasguard.openDashboard",
        "title": "Open BiasGuard Dashboard",
        "category": "BiasGuard"
      },
      {
        "command": "biasguard.analyzeConversation",
        "title": "Analyze Current Conversation",
        "category": "BiasGuard"
      },
      {
        "command": "biasguard.resetDetection",
        "title": "Reset Bias Detection",
        "category": "BiasGuard"
      }
    ],
    "keybindings": [
      {
        "command": "biasguard.toggleOverlay",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "BiasGuard",
      "properties": {
        "biasguard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable BiasGuard bias detection"
        },
        "biasguard.detectionSensitivity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "medium",
          "description": "Bias detection sensitivity level"
        },
        "biasguard.showVisualAlerts": {
          "type": "boolean",
          "default": true,
          "description": "Show visual bias alerts in the editor"
        },
        "biasguard.autoIntervention": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply suggested bias fixes"
        },
        "biasguard.teamMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable team collaboration features"
        },
        "biasguard.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:1437/bias-dashboard",
          "description": "URL for BiasGuard dashboard"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "biasguardStatus",
          "name": "BiasGuard Status",
          "when": "biasguard.enabled"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "biasguard",
          "title": "BiasGuard",
          "icon": "$(brain)"
        }
      ]
    },
    "statusBarItems": [
      {
        "id": "biasguard.status",
        "alignment": "right",
        "priority": 100
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/transformation-mvp/biasguard-cursor.git"
  },
  "bugs": {
    "url": "https://github.com/transformation-mvp/biasguard-cursor/issues"
  },
  "homepage": "https://github.com/transformation-mvp/biasguard-cursor#readme",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  }
} 