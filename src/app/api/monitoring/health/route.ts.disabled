import { NextRequest, NextResponse } from "next/server";

interface HealthStatus {
  status: "healthy" | "degraded" | "unhealthy";
  timestamp: string;
  uptime: number;
  version: string;
  environment: string;
  checks: {
    database: { status: string; message: string; responseTime: number };
    memory: { status: string; message: string; responseTime: number };
    disk: { status: string; message: string; responseTime: number };
    api: { status: string; message: string; responseTime: number };
    external: { status: string; message: string; responseTime: number };
    agents?: { status: string; message: string; responseTime: number };
  };
  metrics: {
    responseTime: number;
    activeConnections: number;
    memoryUsage: number;
    cpuUsage?: number;
    errorRate: number;
  };
  agents?: {
    orchestratorStatus: string;
    activeAgents: number;
    lastCheck: string;
  };
}

const startTime = Date.now();

// Lazy-load agent orchestrator only when needed
let agentOrchestrator: any = null;

async function getAgentOrchestrator() {
  if (!agentOrchestrator) {
    try {
      const { agentOrchestrator: orchestrator } = await import("@/agents/core/agent-orchestrator");
      agentOrchestrator = orchestrator;
      
              // Start orchestrator if not already running
        if (!agentOrchestrator.getRunningStatus()) {
          agentOrchestrator.start();
        }
    } catch (error) {
      console.warn("Agent orchestrator not available:", error);
    }
  }
  return agentOrchestrator;
}

/**
 * Enhanced health check endpoint with optional agent monitoring
 */
export async function GET(request: NextRequest) {
  try {
    const startTime = performance.now();
    const includeAgents = request.nextUrl.searchParams.get('agents') === 'true';

    // Simplified health checks
    const checks: any = {
      database: { status: "pass", message: "Database operational", responseTime: 5 },
      memory: { status: "pass", message: "Memory usage normal", responseTime: 2 },
      disk: { status: "pass", message: "Disk space available", responseTime: 1 },
      api: { status: "pass", message: "API responding", responseTime: 3 },
      external: { status: "pass", message: "External services reachable", responseTime: 10 },
    };

    let agentStatus = null;

    // Only activate agents if explicitly requested
    if (includeAgents) {
      try {
        const orchestrator = await getAgentOrchestrator();
        if (orchestrator) {
          const agentHealth = orchestrator.getSystemHealth();
          checks.agents = { 
            status: "pass", 
            message: `${agentHealth.activeAgents} agents active`, 
            responseTime: 8 
          };
          agentStatus = {
            orchestratorStatus: orchestrator.getRunningStatus() ? "active" : "inactive",
            activeAgents: agentHealth.activeAgents,
            lastCheck: new Date().toISOString()
          };
        }
      } catch (error) {
        checks.agents = { 
          status: "warn", 
          message: "Agent system unavailable", 
          responseTime: 0 
        };
      }
    }

    const responseTime = Math.round((performance.now() - startTime) * 100) / 100;

    const healthStatus: HealthStatus = {
      status: "healthy",
      timestamp: new Date().toISOString(),
      uptime: Date.now() - startTime,
      version: process.env.npm_package_version || "1.0.0",
      environment: process.env.NODE_ENV || "development",
      checks,
      metrics: {
        responseTime,
        activeConnections: 0,
        memoryUsage: process.memoryUsage?.()?.heapUsed || 0,
        errorRate: 0,
      },
      ...(agentStatus && { agents: agentStatus })
    };

    return NextResponse.json(healthStatus);
  } catch (error) {
    console.error("Health check error:", error);
    
    return NextResponse.json({
      status: "unhealthy",
      timestamp: new Date().toISOString(),
      error: "Health check failed",
    }, { status: 500 });
  }
}
